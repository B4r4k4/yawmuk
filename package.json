{
  "name": "yawmuk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "«يومك» Yawmuk — a browser 3D educational game for discovering Islam through everyday situations in the USA",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve:dist": "node tools/serve.mjs dist 4173",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "node tests/e2e/playthrough.mjs",
    "audit": "node tools/audit/verify.mjs && node tools/audit/links.mjs",
    "sources": "node tools/audit/sources_md.mjs",
    "characters:build": "node tools/characters/fetch.mjs && node tools/characters/build.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "puppeteer-core": "^25.12.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
